{
  "name": "dsh-session-deliverables",
  "version": "1.0.1",
  "type": "module",
  "description": "DSH Web 插件：为每个会话增加「文件」视图，列出本会话交付的文件（Word / Excel / PPT / PDF / 图片 / 视频等），支持一键按附件下载。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "deliverables",
    "session-files",
    "download"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoran0829/dsh-session-deliverables.git"
  },
  "homepage": "https://github.com/xiaoran0829/dsh-session-deliverables#readme",
  "bugs": {
    "url": "https://github.com/xiaoran0829/dsh-session-deliverables/issues"
  }
}
