{
  "name": "dsh-session-deliverables",
  "version": "1.0.0",
  "type": "module",
  "description": "Per-session deliverables view for DSH: lists the files a Session delivered (Word, Excel, PPT, images, video) in the Session header and downloads any of them as an attachment.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "deliverables",
    "session-files",
    "download"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoran0829/dsh-session-deliverables.git"
  },
  "homepage": "https://github.com/xiaoran0829/dsh-session-deliverables#readme",
  "bugs": {
    "url": "https://github.com/xiaoran0829/dsh-session-deliverables/issues"
  }
}
